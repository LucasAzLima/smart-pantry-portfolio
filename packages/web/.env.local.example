# Supabase project settings (Dashboard → Project Settings → API)
# Use the Project URL only (no /rest/v1 path).
#
# Local: copy this file to `.env.local` in this package.
# Vercel: set the same keys in Project → Settings → Environment Variables
# (Production and Preview). See the repo README "Deploying to Vercel" section.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
